// use prisma-8
enum UserRole {
  @@type("pg/text@1")

  SUPER_ADMIN = "SUPER_ADMIN"
  ADMIN = "ADMIN"
  MANAGER = "MANAGER"
}

enum AccountTokenType {
  @@type("pg/text@1")

  PASSWORD_RESET = "PASSWORD_RESET"
  EMAIL_VERIFICATION = "EMAIL_VERIFICATION"
}

enum MemberStatus {
  @@type("pg/text@1")

  ACTIVE = "ACTIVE"
  INACTIVE = "INACTIVE"
  SUSPENDED = "SUSPENDED"
}

enum AddressType {
  @@type("pg/text@1")

  PRESENT = "PRESENT"
  FATHER_HOME = "FATHER_HOME"
}

enum InstallmentFrequency {
  @@type("pg/text@1")

  WEEKLY = "WEEKLY"
  MONTHLY = "MONTHLY"
}

enum LoanChargeType {
  @@type("pg/text@1")

  FLAT = "FLAT"
  PERCENTAGE = "PERCENTAGE"
}

enum LoanStatus {
  @@type("pg/text@1")

  PENDING = "PENDING"
  APPROVED = "APPROVED"
  ACTIVE = "ACTIVE"
  COMPLETED = "COMPLETED"
  REJECTED = "REJECTED"
  CANCELLED = "CANCELLED"
}

enum InstallmentStatus {
  @@type("pg/text@1")

  PENDING = "PENDING"
  PARTIAL = "PARTIAL"
  PAID = "PAID"
}

enum PaymentMethod {
  @@type("pg/text@1")

  CASH = "CASH"
  BANK_TRANSFER = "BANK_TRANSFER"
  MOBILE_PAYMENT = "MOBILE_PAYMENT"
  CHEQUE = "CHEQUE"
  OTHER = "OTHER"
}

enum SavingsAccountStatus {
  @@type("pg/text@1")

  ACTIVE = "ACTIVE"
  CLOSED = "CLOSED"
}

enum SavingsType {
  @@type("pg/text@1")

  GENERAL = "GENERAL"
  SPECIAL = "SPECIAL"
}

enum SavingsTransactionType {
  @@type("pg/text@1")

  DEPOSIT = "DEPOSIT"
  WITHDRAWAL = "WITHDRAWAL"
}

model User {
  id              Int                  @id @default(autoincrement())
  email           String               @unique
  userName        String?
  fullName        String?
  password        String
  createdAt       DateTime             @default(now())
  updatedAt       temporal.updatedAt()
  role            UserRole             @default(MANAGER)
  emailVerifiedAt DateTime?

  collections     Collection[]
  processedSavingsTransactions SavingsTransaction[] @relation("SavingsTransactionProcessedBy")
  sessions        Session[]
  accountTokens   AccountToken[]
  approvedLoans   Loan[]               @relation("LoanApprovedBy")
  rejectedLoans   Loan[]               @relation("LoanRejectedBy")
}

model Session {
  id                Int       @id @default(autoincrement())
  userId            Int
  jti               String    @unique @default(uuid())
  familyId          String    @default(uuid())
  refreshTokenHash  String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  consumedAt        DateTime?
  replacedByJti     String?
  absoluteExpiresAt DateTime
  rememberMe        Boolean   @default(false)
  createdAt         DateTime  @default(now())

  user              User      @relation(fields:[userId], references:[id])

  @@index([userId])
  @@index([familyId])
}

model AccountToken {
  id         Int              @id @default(autoincrement())
  userId     Int
  type       AccountTokenType
  tokenHash  String           @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  user       User             @relation(fields:[userId], references:[id])

  @@index([userId, type])
  @@index([expiresAt])
}

model Member {
  id             Int                  @id @default(autoincrement())
  memberId       String?              @unique

  // Personal Information
  fullName       String
  fatherName     String
  motherName     String
  guardianName   String?

  mobileNumber   String
  nidNumber      String?              @unique

  // Optional Information
  email          String?
  photoUrl       String?
  occupation     String?

  // Membership
  joinDate       DateTime             @default(now())
  status         MemberStatus         @default(ACTIVE)

  // Additional Information
  notes          String?

  // Relations
  addresses      MemberAddress[]
  guarantors     Guarantor[]
  loans          Loan[]

  savingsAccount SavingsAccount?
  collections    Collection[]

  createdAt      DateTime             @default(now())
  updatedAt      temporal.updatedAt()

  @@index([memberId])
  @@index([fullName])
  @@index([mobileNumber])
  @@index([status])
  @@index([createdAt])
}

model MemberAddress {
  id             Int                  @id @default(autoincrement())
  memberId       Int
  type           AddressType

  // Address
  houseOrHolding String?
  road           String?
  village        String
  postOffice     String
  union          String?
  upazila        String
  district       String
  division       String?

  // Relations
  member         Member               @relation(fields:[memberId], references:[id], onDelete: Cascade)

  createdAt      DateTime             @default(now())
  updatedAt      temporal.updatedAt()

  @@unique([memberId, type])
  @@index([memberId])
  @@index([district])
  @@index([upazila])
}

model Guarantor {
  id             Int                  @id @default(autoincrement())
  memberId       Int

  // Personal Information
  fullName       String
  fatherName     String?
  motherName     String?
  mobileNumber   String
  nidNumber      String?

  // Relationship with member
  relationship   String

  // Address
  houseOrHolding String?
  road           String?
  village        String
  postOffice     String
  union          String?
  upazila        String
  district       String
  division       String?

  // Additional Information
  occupation     String?
  notes          String?

  // Relations
  member         Member               @relation(fields:[memberId], references:[id], onDelete: Cascade)

  createdAt      DateTime             @default(now())
  updatedAt      temporal.updatedAt()

  @@index([memberId])
  @@index([mobileNumber])
  @@index([nidNumber])
}

model Loan {
  id                Int                  @id @default(autoincrement())
  loanId            String?              @unique

  // Member
  memberId          Int
  member            Member               @relation(fields:[memberId], references:[id])

  // Amount
  principalAmount   Decimal

  // Charge
  chargeType        LoanChargeType
  chargeValue       Decimal
  chargeAmount      Decimal

  // Final calculated amount
  totalPayable      Decimal

  // Installment configuration
  installmentCount  Int
  installmentAmount Decimal

  frequency         InstallmentFrequency

  // Dates
  applicationDate   DateTime             @default(now())
  disbursementDate  DateTime?
  firstDueDate      DateTime?
  maturityDate      DateTime?
  approvedAt        DateTime?
  approvedById      Int?
  approvedBy        User?                @relation("LoanApprovedBy", fields:[approvedById], references:[id])
  rejectedAt        DateTime?
  rejectedById      Int?
  rejectedBy        User?                @relation("LoanRejectedBy", fields:[rejectedById], references:[id])
  rejectionReason   String?

  // Status
  status            LoanStatus           @default(PENDING)
  purpose           String?
  notes             String?
  installments      LoanInstallment[]
  payments          LoanPayment[]
  createdAt         DateTime             @default(now())
  updatedAt         temporal.updatedAt()

  @@index([memberId])
  @@index([loanId])
  @@index([status])
  @@index([createdAt])
}

model LoanInstallment {
  id            Int                  @id @default(autoincrement())
  loanId        Int
  loan          Loan                 @relation(fields:[loanId], references:[id], onDelete: Cascade)
  installmentNo Int
  dueDate       DateTime
  amount        Decimal
  paidAmount    Decimal              @default("0")
  status        InstallmentStatus    @default(PENDING)
  paidAt        DateTime?
  payments      LoanPayment[]
  createdAt     DateTime             @default(now())
  updatedAt     temporal.updatedAt()

  @@unique([loanId, installmentNo])
  @@index([loanId])
  @@index([dueDate])
  @@index([status])
}

model LoanPayment {
  id            Int              @id @default(autoincrement())
  paymentId     String?          @unique
  loanId        Int
  loan          Loan             @relation(fields:[loanId], references:[id])
  installmentId Int?
  installment   LoanInstallment? @relation(fields:[installmentId], references:[id])
  amount        Decimal
  paymentDate   DateTime         @default(now())
  paymentMethod PaymentMethod    @default(CASH)
  reference     String?
  notes         String?

  collectionId  Int?
  collection    Collection?      @relation(fields:[collectionId], references:[id])

  createdAt     DateTime         @default(now())

  @@index([collectionId])
  @@index([loanId])
  @@index([installmentId])
  @@index([paymentDate])
}

model SavingsAccount {
  id                    Int                  @id @default(autoincrement())
  accountId             String?              @unique

  memberId              Int                  @unique
  member                Member               @relation(fields:[memberId], references:[id])

  generalSavingsBalance Decimal              @default("0")
  specialSavingsBalance Decimal              @default("0")

  status                SavingsAccountStatus @default(ACTIVE)

  openedAt              DateTime             @default(now())
  closedAt              DateTime?
  notes                 String?

  transactions          SavingsTransaction[]

  createdAt             DateTime             @default(now())
  updatedAt             temporal.updatedAt()

  @@index([accountId])
  @@index([status])
}

model SavingsTransaction {
  id               Int                    @id @default(autoincrement())
  transactionId    String?                @unique

  savingsAccountId Int
  savingsAccount   SavingsAccount         @relation(fields:[savingsAccountId], references:[id])

  collectionId     Int?
  collection       Collection?            @relation(fields:[collectionId], references:[id])

  processedById    Int?
  processedBy      User?                  @relation("SavingsTransactionProcessedBy", fields:[processedById], references:[id])

  savingsType      SavingsType
  type             SavingsTransactionType

  amount           Decimal

  balanceBefore    Decimal
  balanceAfter     Decimal

  transactionDate  DateTime               @default(now())

  paymentMethod    PaymentMethod          @default(CASH)
  reference        String?
  notes            String?

  createdAt        DateTime               @default(now())

  @@index([savingsAccountId])
  @@index([collectionId])
  @@index([processedById])
  @@index([savingsType])
  @@index([type])
  @@index([transactionDate])
}

model Collection {
  id                  Int                  @id @default(autoincrement())
  collectionId        String?              @unique

  memberId            Int
  member              Member               @relation(fields:[memberId], references:[id])

  collectedById       Int
  collectedBy         User                 @relation(fields:[collectedById], references:[id])

    loanCollectionAmount  Decimal  @default("0")
  generalSavingsAmount  Decimal  @default("0")
  specialSavingsAmount  Decimal  @default("0")
  totalAmount           Decimal  @default("0")

  collectionDate      DateTime             @default(now())
  paymentMethod       PaymentMethod        @default(CASH)

  reference           String?
  notes               String?

  loanPayments        LoanPayment[]
  savingsTransactions SavingsTransaction[]

  createdAt           DateTime             @default(now())
  updatedAt           temporal.updatedAt()

  @@index([memberId])
  @@index([collectionId])
  @@index([collectionDate])
}
