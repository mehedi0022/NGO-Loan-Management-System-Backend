// use prisma-8
enum UserRole {
  @@type("pg/text@1")

  SUPER_ADMIN = "SUPER_ADMIN"
  ADMIN = "ADMIN"
  MANAGER = "MANAGER"
  FIELD_OFFICER = "FIELD_OFFICER"
}

enum AccountTokenType {
  @@type("pg/text@1")

  PASSWORD_RESET = "PASSWORD_RESET"
  EMAIL_VERIFICATION = "EMAIL_VERIFICATION"
}

enum MemberStatus {
  @@type("pg/text@1")

  ACTIVE = "ACTIVE"
  INACTIVE = "INACTIVE"
  SUSPENDED = "SUSPENDED"
}

enum SomitiDay {
  @@type("pg/text@1")

  SATURDAY = "SATURDAY"
  SUNDAY = "SUNDAY"
  MONDAY = "MONDAY"
  TUESDAY = "TUESDAY"
  WEDNESDAY = "WEDNESDAY"
  THURSDAY = "THURSDAY"
  FRIDAY = "FRIDAY"
}

enum SomitiStatus {
  @@type("pg/text@1")

  ACTIVE = "ACTIVE"
  INACTIVE = "INACTIVE"
}

enum AddressType {
  @@type("pg/text@1")

  PRESENT = "PRESENT"
  FATHER_HOME = "FATHER_HOME"
}

enum InstallmentFrequency {
  @@type("pg/text@1")

  WEEKLY = "WEEKLY"
  MONTHLY = "MONTHLY"
}

enum LoanChargeType {
  @@type("pg/text@1")

  FLAT = "FLAT"
  PERCENTAGE = "PERCENTAGE"
}

enum LoanStatus {
  @@type("pg/text@1")

  PENDING = "PENDING"
  APPROVED = "APPROVED"
  ACTIVE = "ACTIVE"
  COMPLETED = "COMPLETED"
  REJECTED = "REJECTED"
  CANCELLED = "CANCELLED"
}

enum InstallmentStatus {
  @@type("pg/text@1")

  PENDING = "PENDING"
  PARTIAL = "PARTIAL"
  PAID = "PAID"
}

enum PaymentMethod {
  @@type("pg/text@1")

  CASH = "CASH"
  BANK_TRANSFER = "BANK_TRANSFER"
  MOBILE_PAYMENT = "MOBILE_PAYMENT"
  CHEQUE = "CHEQUE"
  OTHER = "OTHER"
}

enum SavingsAccountStatus {
  @@type("pg/text@1")

  ACTIVE = "ACTIVE"
  CLOSED = "CLOSED"
}

enum SavingsType {
  @@type("pg/text@1")

  GENERAL = "GENERAL"
  SPECIAL = "SPECIAL"
}

enum SavingsTransactionType {
  @@type("pg/text@1")

  DEPOSIT = "DEPOSIT"
  WITHDRAWAL = "WITHDRAWAL"
}

enum TransactionType {
  @@type("pg/text@1")

  INCOME = "INCOME"
  EXPENSE = "EXPENSE"
}

enum DpsStatus {
  @@type("pg/text@1")

  ACTIVE = "ACTIVE"
  MATURED = "MATURED"
  CLOSED = "CLOSED"
}

enum FinancialAccountType {
  @@type("pg/text@1")

  CASH = "CASH"
  BANK = "BANK"
  MOBILE_BANKING = "MOBILE_BANKING"
}

enum AccountTransactionType {
  @@type("pg/text@1")

  DEBIT = "DEBIT"
  CREDIT = "CREDIT"
}

enum AccountSourceModule {
  @@type("pg/text@1")

  CAPITAL_INJECTION = "CAPITAL_INJECTION"
  MEMBER_ADMISSION = "MEMBER_ADMISSION"
  LOAN_DISBURSEMENT = "LOAN_DISBURSEMENT"
  LOAN_COLLECTION = "LOAN_COLLECTION"
  SAVINGS_DEPOSIT = "SAVINGS_DEPOSIT"
  SAVINGS_WITHDRAWAL = "SAVINGS_WITHDRAWAL"
  DPS_DEPOSIT = "DPS_DEPOSIT"
  DPS_WITHDRAWAL = "DPS_WITHDRAWAL"
  OFFICE_EXPENSE = "OFFICE_EXPENSE"
  OTHER_INCOME = "OTHER_INCOME"
  FUND_TRANSFER = "FUND_TRANSFER"
}

model User {
  id                           Int                  @id @default(autoincrement())
  email                        String               @unique
  userName                     String?
  fullName                     String?
  password                     String
  createdAt                    DateTime             @default(now())
  updatedAt                    temporal.updatedAt()
  role                         UserRole             @default(MANAGER)
  isActive                     Boolean              @default(true)
  emailVerifiedAt              DateTime?

  collections                  Collection[]
  processedSavingsTransactions SavingsTransaction[] @relation("SavingsTransactionProcessedBy")
  sessions                     Session[]
  accountTokens                AccountToken[]
  approvedLoans                Loan[]               @relation("LoanApprovedBy")
  rejectedLoans                Loan[]               @relation("LoanRejectedBy")
  assignedSomities             Somiti[]             @relation("SomitiFieldOfficer")
  incomeExpenses               IncomeExpense[]      @relation("IncomeExpenseCreatedBy")
  openedDpsAccounts            DpsAccount[]         @relation("DpsAccountOpenedBy")
  processedDpsTransactions     DpsTransaction[]     @relation("DpsTransactionProcessedBy")
  accountTransactions          AccountTransaction[] @relation("AccountTransactionCreatedBy")
}

model Session {
  id                Int       @id @default(autoincrement())
  userId            Int
  jti               String    @unique @default(uuid())
  familyId          String    @default(uuid())
  refreshTokenHash  String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  consumedAt        DateTime?
  replacedByJti     String?
  absoluteExpiresAt DateTime
  rememberMe        Boolean   @default(false)
  createdAt         DateTime  @default(now())

  user              User      @relation(fields:[userId], references:[id])

  @@index([userId])
  @@index([familyId])
}

model AccountToken {
  id         Int              @id @default(autoincrement())
  userId     Int
  type       AccountTokenType
  tokenHash  String           @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  user       User             @relation(fields:[userId], references:[id])

  @@index([userId, type])
  @@index([expiresAt])
}

model Somiti {
  id             Int                  @id @default(autoincrement())
  somitiId       String?              @unique
  name           String
  code           String?              @unique
  meetingDay     SomitiDay            @default(SUNDAY)
  meetingTime    String?

  fieldOfficerId Int?
  fieldOfficer   User?                @relation("SomitiFieldOfficer", fields:[fieldOfficerId], references:[id])

  village        String?
  union          String?
  upazila        String?
  district       String?

  status         SomitiStatus         @default(ACTIVE)

  members        Member[]
  incomeExpenses IncomeExpense[]

  createdAt      DateTime             @default(now())
  updatedAt      temporal.updatedAt()

  @@index([somitiId])
  @@index([name])
  @@index([fieldOfficerId])
  @@index([status])
  @@index([meetingDay])
}

model Member {
  id             Int                  @id @default(autoincrement())
  memberId       String?              @unique

  // Personal Information
  fullName       String
  fatherName     String
  motherName     String
  guardianName   String?

  mobileNumber   String
  nidNumber      String?              @unique

  // Optional Information
  email          String?
  photoUrl       String?
  occupation     String?

  // Membership
  joinDate       DateTime             @default(now())
  status         MemberStatus         @default(ACTIVE)
  admissionFee   Decimal              @default("0")

  // Somiti
  somitiId       Int?
  somiti         Somiti?              @relation(fields:[somitiId], references:[id])

  // Additional Information
  notes          String?

  // Relations
  addresses      MemberAddress[]
  guarantors     Guarantor[]
  loans          Loan[]

  savingsAccount SavingsAccount?
  dpsAccounts    DpsAccount[]
  collections    Collection[]

  createdAt      DateTime             @default(now())
  updatedAt      temporal.updatedAt()

  @@index([memberId])
  @@index([fullName])
  @@index([mobileNumber])
  @@index([status])
  @@index([somitiId])
  @@index([createdAt])
}

model MemberAddress {
  id             Int                  @id @default(autoincrement())
  memberId       Int
  type           AddressType

  // Address
  houseOrHolding String?
  road           String?
  village        String
  postOffice     String
  union          String?
  upazila        String
  district       String
  division       String?

  // Relations
  member         Member               @relation(fields:[memberId], references:[id], onDelete: Cascade)

  createdAt      DateTime             @default(now())
  updatedAt      temporal.updatedAt()

  @@unique([memberId, type])
  @@index([memberId])
  @@index([district])
  @@index([upazila])
}

model Guarantor {
  id             Int                  @id @default(autoincrement())
  memberId       Int

  // Personal Information
  fullName       String
  fatherName     String?
  motherName     String?
  mobileNumber   String
  nidNumber      String?

  // Relationship with member
  relationship   String

  // Address
  houseOrHolding String?
  road           String?
  village        String
  postOffice     String
  union          String?
  upazila        String
  district       String
  division       String?

  // Additional Information
  occupation     String?
  notes          String?

  // Relations
  member         Member               @relation(fields:[memberId], references:[id], onDelete: Cascade)

  createdAt      DateTime             @default(now())
  updatedAt      temporal.updatedAt()

  @@index([memberId])
  @@index([mobileNumber])
  @@index([nidNumber])
}

model Loan {
  id                Int                  @id @default(autoincrement())
  loanId            String?              @unique

  // Member
  memberId          Int
  member            Member               @relation(fields:[memberId], references:[id])

  // Amount
  principalAmount   Decimal

  // Charge
  chargeType        LoanChargeType
  chargeValue       Decimal
  chargeAmount      Decimal

  // Final calculated amount
  totalPayable      Decimal

  // Installment configuration
  installmentCount  Int
  installmentAmount Decimal

  frequency         InstallmentFrequency

  // Dates
  applicationDate   DateTime             @default(now())
  disbursementDate  DateTime?
  firstDueDate      DateTime?
  maturityDate      DateTime?
  approvedAt        DateTime?
  approvedById      Int?
  approvedBy        User?                @relation("LoanApprovedBy", fields:[approvedById], references:[id])
  rejectedAt        DateTime?
  rejectedById      Int?
  rejectedBy        User?                @relation("LoanRejectedBy", fields:[rejectedById], references:[id])
  rejectionReason   String?

  // Status
  status            LoanStatus           @default(PENDING)
  purpose           String?
  notes             String?
  installments      LoanInstallment[]
  payments          LoanPayment[]
  createdAt         DateTime             @default(now())
  updatedAt         temporal.updatedAt()

  @@index([memberId])
  @@index([loanId])
  @@index([status])
  @@index([createdAt])
}

model LoanInstallment {
  id            Int                  @id @default(autoincrement())
  loanId        Int
  loan          Loan                 @relation(fields:[loanId], references:[id], onDelete: Cascade)
  installmentNo Int
  dueDate       DateTime
  amount        Decimal
  paidAmount    Decimal              @default("0")
  status        InstallmentStatus    @default(PENDING)
  paidAt        DateTime?
  payments      LoanPayment[]
  createdAt     DateTime             @default(now())
  updatedAt     temporal.updatedAt()

  @@unique([loanId, installmentNo])
  @@index([loanId])
  @@index([dueDate])
  @@index([status])
}

model LoanPayment {
  id            Int              @id @default(autoincrement())
  paymentId     String?          @unique
  loanId        Int
  loan          Loan             @relation(fields:[loanId], references:[id])
  installmentId Int?
  installment   LoanInstallment? @relation(fields:[installmentId], references:[id])
  amount        Decimal
  paymentDate   DateTime         @default(now())
  paymentMethod PaymentMethod    @default(CASH)
  reference     String?
  notes         String?

  collectionId  Int?
  collection    Collection?      @relation(fields:[collectionId], references:[id])

  createdAt     DateTime         @default(now())

  @@index([collectionId])
  @@index([loanId])
  @@index([installmentId])
  @@index([paymentDate])
}

model SavingsAccount {
  id                    Int                  @id @default(autoincrement())
  accountId             String?              @unique

  memberId              Int                  @unique
  member                Member               @relation(fields:[memberId], references:[id])

  generalSavingsBalance Decimal              @default("0")
  specialSavingsBalance Decimal              @default("0")

  status                SavingsAccountStatus @default(ACTIVE)

  openedAt              DateTime             @default(now())
  closedAt              DateTime?
  notes                 String?

  transactions          SavingsTransaction[]

  createdAt             DateTime             @default(now())
  updatedAt             temporal.updatedAt()

  @@index([accountId])
  @@index([status])
}

model SavingsTransaction {
  id               Int                    @id @default(autoincrement())
  transactionId    String?                @unique

  savingsAccountId Int
  savingsAccount   SavingsAccount         @relation(fields:[savingsAccountId], references:[id])

  collectionId     Int?
  collection       Collection?            @relation(fields:[collectionId], references:[id])

  processedById    Int?
  processedBy      User?                  @relation("SavingsTransactionProcessedBy", fields:[processedById], references:[id])

  savingsType      SavingsType
  type             SavingsTransactionType

  amount           Decimal

  balanceBefore    Decimal
  balanceAfter     Decimal

  transactionDate  DateTime               @default(now())

  paymentMethod    PaymentMethod          @default(CASH)
  reference        String?
  notes            String?

  createdAt        DateTime               @default(now())

  @@index([savingsAccountId])
  @@index([collectionId])
  @@index([processedById])
  @@index([savingsType])
  @@index([type])
  @@index([transactionDate])
}

model Collection {
  id                   Int                  @id @default(autoincrement())
  collectionId         String?              @unique

  memberId             Int
  member               Member               @relation(fields:[memberId], references:[id])

  collectedById        Int
  collectedBy          User                 @relation(fields:[collectedById], references:[id])

  loanCollectionAmount Decimal              @default("0")
  generalSavingsAmount Decimal              @default("0")
  specialSavingsAmount Decimal              @default("0")
  dpsAmount            Decimal              @default("0")
  totalAmount          Decimal              @default("0")

  collectionDate       DateTime             @default(now())
  paymentMethod        PaymentMethod        @default(CASH)

  reference            String?
  notes                String?

  loanPayments         LoanPayment[]
  savingsTransactions  SavingsTransaction[]
  dpsTransactions      DpsTransaction[]

  createdAt            DateTime             @default(now())
  updatedAt            temporal.updatedAt()

  @@index([memberId])
  @@index([collectionId])
  @@index([collectionDate])
}

model TransactionCategory {
  id           Int                  @id @default(autoincrement())
  name         String
  type         TransactionType
  description  String?
  isSystem     Boolean              @default(false)
  isActive     Boolean              @default(true)

  transactions IncomeExpense[]

  createdAt    DateTime             @default(now())
  updatedAt    temporal.updatedAt()

  @@unique([name, type])
  @@index([type])
  @@index([isActive])
}

model IncomeExpense {
  id            Int                  @id @default(autoincrement())
  voucherNo     String               @unique

  type          TransactionType

  categoryId    Int
  category      TransactionCategory  @relation(fields:[categoryId], references:[id])

  amount        Decimal
  date          DateTime             @default(now())
  paymentMethod PaymentMethod        @default(CASH)
  reference     String?
  description   String?

  somitiId      Int?
  somiti        Somiti?              @relation(fields:[somitiId], references:[id])

  createdById   Int
  createdBy     User                 @relation("IncomeExpenseCreatedBy", fields:[createdById], references:[id])

  createdAt     DateTime             @default(now())
  updatedAt     temporal.updatedAt()

  @@index([voucherNo])
  @@index([type])
  @@index([categoryId])
  @@index([date])
  @@index([paymentMethod])
  @@index([somitiId])
  @@index([createdById])
}

model OrganizationSetting {
  id                       Int                  @id @default(autoincrement())

  // Organization Info
  orgName                  String               @default("Purbasha Financial Development Organization")
  orgShortName             String?              @default("PFDO")
  registrationNo           String?              @default("REG-NGO-2024-001")
  establishedYear          String?              @default("2018")
  logoUrl                  String?

  // Contact & Address
  email                    String?              @default("info@purbasha.org")
  phone                    String?              @default("+8801700000000")
  address                  String?              @default("Main Road, Branch Office, Bangladesh")
  website                  String?

  // Financial & Policy Defaults
  currencySymbol           String               @default("৳")
  currencyCode             String               @default("BDT")
  defaultLoanChargeType    LoanChargeType       @default(PERCENTAGE)
  defaultLoanChargeValue   Decimal              @default("10")
  defaultLoanFrequency     InstallmentFrequency @default(WEEKLY)
  defaultGraceDays         Int                  @default(0)
  latePenaltyPercentage    Decimal              @default("0")

  // Savings Defaults
  minGeneralSavingsDeposit Decimal              @default("50")
  minSpecialSavingsDeposit Decimal              @default("100")

  updatedAt                temporal.updatedAt()
}

model DpsAccount {
  id                Int                  @id @default(autoincrement())
  dpsNumber         String?              @unique

  memberId          Int
  member            Member               @relation(fields:[memberId], references:[id])

  frequency         InstallmentFrequency @default(MONTHLY)
  installmentAmount Decimal
  durationMonths    Int
  interestRate      Decimal

  totalPrincipal    Decimal
  maturityAmount    Decimal

  totalPaidAmount   Decimal              @default("0")
  paidInstallments  Int                  @default(0)

  startDate         DateTime             @default(now())
  maturityDate      DateTime

  status            DpsStatus            @default(ACTIVE)
  notes             String?

  openedById        Int?
  openedBy          User?                @relation("DpsAccountOpenedBy", fields:[openedById], references:[id])

  installments      DpsInstallment[]
  transactions      DpsTransaction[]

  createdAt         DateTime             @default(now())
  updatedAt         temporal.updatedAt()

  @@index([dpsNumber])
  @@index([memberId])
  @@index([status])
}

model DpsInstallment {
  id            Int                  @id @default(autoincrement())
  dpsAccountId  Int
  dpsAccount    DpsAccount           @relation(fields:[dpsAccountId], references:[id], onDelete: Cascade)

  installmentNo Int
  dueDate       DateTime
  amount        Decimal
  paidAmount    Decimal              @default("0")
  status        InstallmentStatus    @default(PENDING)
  paidAt        DateTime?

  createdAt     DateTime             @default(now())
  updatedAt     temporal.updatedAt()

  @@unique([dpsAccountId, installmentNo])
  @@index([dpsAccountId])
  @@index([dueDate])
}

model DpsTransaction {
  id              Int           @id @default(autoincrement())
  transactionId   String?       @unique

  dpsAccountId    Int
  dpsAccount      DpsAccount    @relation(fields:[dpsAccountId], references:[id])

  collectionId    Int?
  collection      Collection?   @relation(fields:[collectionId], references:[id])

  processedById   Int?
  processedBy     User?         @relation("DpsTransactionProcessedBy", fields:[processedById], references:[id])

  type            String
  amount          Decimal
  balanceBefore   Decimal
  balanceAfter    Decimal

  transactionDate DateTime      @default(now())
  paymentMethod   PaymentMethod @default(CASH)
  reference       String?
  notes           String?

  createdAt       DateTime      @default(now())

  @@index([dpsAccountId])
  @@index([collectionId])
  @@index([processedById])
}

model FinancialAccount {
  id             Int                  @id @default(autoincrement())
  accountName    String
  accountType    FinancialAccountType @default(CASH)
  accountNumber  String?
  bankName       String?
  branchName     String?
  currentBalance Decimal              @default("0")
  isDefault      Boolean              @default(false)
  isActive       Boolean              @default(true)
  notes          String?

  transactions   AccountTransaction[]

  createdAt      DateTime             @default(now())
  updatedAt      temporal.updatedAt()

  @@index([accountType])
  @@index([isDefault])
  @@index([isActive])
}

model AccountTransaction {
  id              Int                    @id @default(autoincrement())
  transactionId   String?                @unique
  accountId       Int
  account         FinancialAccount       @relation(fields:[accountId], references:[id])

  type            AccountTransactionType
  amount          Decimal
  balanceBefore   Decimal                @default("0")
  balanceAfter    Decimal                @default("0")

  sourceModule    AccountSourceModule
  referenceId     String?
  description     String?

  transactionDate DateTime               @default(now())
  createdById     Int?
  createdBy       User?                  @relation("AccountTransactionCreatedBy", fields:[createdById], references:[id])

  createdAt       DateTime               @default(now())

  @@index([transactionId])
  @@index([accountId])
  @@index([type])
  @@index([sourceModule])
  @@index([transactionDate])
}
