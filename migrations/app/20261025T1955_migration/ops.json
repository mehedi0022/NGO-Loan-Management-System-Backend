    "execute": [
      {
        "description": "create table \"somiti\"",
        "sql": "CREATE TABLE \"public\".\"somiti\" (\n  \"code\" text,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"district\" text,\n  \"fieldOfficerId\" int4,\n  \"id\" SERIAL NOT NULL,\n  \"meetingDay\" text DEFAULT 'SUNDAY' NOT NULL,\n  \"meetingTime\" text,\n  \"name\" text NOT NULL,\n  \"somitiId\" text,\n  \"status\" text DEFAULT 'ACTIVE' NOT NULL,\n  \"union\" text,\n  \"upazila\" text,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"village\" text,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"somiti_meetingDay_check_08e514e5\" CHECK (\"meetingDay\" IN ('SATURDAY', 'SUNDAY', 'MONDAY', 'TUESDAY', 'WEDNESDAY', 'THURSDAY', 'FRIDAY')),\n  CONSTRAINT \"somiti_status_check_ee520df2\" CHECK (\"status\" IN ('ACTIVE', 'INACTIVE'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"somiti\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"somiti\""
        ]
      }
    ]
