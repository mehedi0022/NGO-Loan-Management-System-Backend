    "execute": [
      {
        "description": "create table \"accountTransaction\"",
        "sql": "CREATE TABLE \"public\".\"accountTransaction\" (\n  \"accountId\" int4 NOT NULL,\n  \"amount\" numeric NOT NULL,\n  \"balanceAfter\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"balanceBefore\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"createdById\" int4,\n  \"description\" text,\n  \"id\" SERIAL NOT NULL,\n  \"referenceId\" text,\n  \"sourceModule\" text NOT NULL,\n  \"transactionDate\" timestamptz DEFAULT (now()) NOT NULL,\n  \"transactionId\" text,\n  \"type\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"accountTransaction_sourceModule_check_3daa8bba\" CHECK (\"sourceModule\" IN ('CAPITAL_INJECTION', 'MEMBER_ADMISSION', 'LOAN_DISBURSEMENT', 'LOAN_COLLECTION', 'SAVINGS_DEPOSIT', 'SAVINGS_WITHDRAWAL', 'DPS_DEPOSIT', 'DPS_WITHDRAWAL', 'OFFICE_EXPENSE', 'OTHER_INCOME', 'FUND_TRANSFER')),\n  CONSTRAINT \"accountTransaction_type_check_4b8e93d7\" CHECK (\"type\" IN ('DEBIT', 'CREDIT'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"accountTransaction\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"accountTransaction\""
        ]
      }
    ]
