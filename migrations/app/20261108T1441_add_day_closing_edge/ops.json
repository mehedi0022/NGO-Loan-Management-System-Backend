        "description": "create table \"dayClosing\"",
        "sql": "CREATE TABLE \"public\".\"dayClosing\" (\n  \"admissionFee\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"businessDate\" timestamptz NOT NULL,\n  \"capitalReceived\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"closedAt\" timestamptz,\n  \"closedById\" int4,\n  \"closingBalance\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"dpsDeposit\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"dpsWithdrawn\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"isHoliday\" bool DEFAULT false NOT NULL,\n  \"loanCollection\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"loanDisbursed\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"notes\" text,\n  \"officeExpense\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"openedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"openingBalance\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"otherIncome\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"savingsDeposit\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"savingsWithdrawn\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"status\" text DEFAULT 'OPEN' NOT NULL,\n  \"totalCashIn\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"totalCashOut\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"dayClosing_status_check_32214e16\" CHECK (\"status\" IN ('OPEN', 'CLOSED'))\n)",
        "params": []
      }
